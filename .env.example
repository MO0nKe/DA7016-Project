# Copy to .env and fill in what you need. Real environment variables override this file.
# With nothing set, the app talks to the local mock server (mock_server/) and spends no credits.

# --- Which APIs to use ------------------------------------------------------------------------------
# Leave both commented to use the mock on http://localhost:9000; `make backend-live` sets them for one run.
# Set them here to make every run live (the top bar shows "Live"; live and mock keep separate data under
# data/live and data/mock).
# BODHAN_BASE_URL=https://api.bodhan.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Keys (live only) -------------------------------------------------------------------------------
# Bodhan issues one key per model; https://console.bodhan.ai
BODHAN_OCR=
BODHAN_TRANSLATE=
BODHAN_TRANSLITERATE=
# OpenRouter (prompt edits, heading revision, structure review, the evaluation's judge); https://openrouter.ai/keys
OPENROUTER=

# --- Optional ---------------------------------------------------------------------------------------
# Model for the evaluation's judge (prompt edits, the structure review and the heading pass use Claude Sonnet).
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Live Bodhan calls per minute (indic-translate rejects more than 15 a minute).
# BODHAN_PER_MINUTE=15
# Where documents, the request cache and the usage ledger live (default: data/live or data/mock).
# DATA_DIR=data/live

# --- Mock server only -------------------------------------------------------------------------------
# MOCK_LATENCY_MS=0          slow every answer down (to watch progress UI)
# MOCK_ERROR_RATE=0          fraction of requests that fail with a random API error
# MOCK_LLM=echo              echo | forward (send OpenRouter calls to a free model, needs OPENROUTER)
